        <mxCell id="e_r_dian" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#4A5568;" edge="1" parent="1" source="lan_router" target="n_dian" />
        <mxCell id="e_crm_db" value="Conexión Interna Cifrada (VPC)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1C5C38;" edge="1" parent="1" source="n_crm" target="n_db" />
        <mxCell id="e_db_bak" value="Snapshot Diario Automático 3-2-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeWidth=2;strokeColor=#2B6CB0;" edge="1" parent="1" source="n_db" target="n_bak" />
        <mxCell id="e_ven_r" value="LAN Ethernet / Wi-Fi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2B6CB0;" edge="1" parent="1" source="pc_ventas" target="lan_router" />
        <mxCell id="e_alm_r" value="LAN Ethernet / Wi-Fi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2B6CB0;" edge="1" parent="1" source="pc_alm" target="lan_router" />
        <mxCell id="e_tab_r" value="Wi-Fi Seguro WPA3 (HTTPS en tiempo real)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2E8B57;fontStyle=1;" edge="1" parent="1" source="tab_planta" target="lan_router" />
        <mxCell id="e_tab_maq" value="Orden de corte y lote asignado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2E8B57;" edge="1" parent="1" source="tab_planta" target="maq_sms" />
        <mxCell id="e_maq_desp" value="Prendas quirúrgicas confeccionadas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4A5568;" edge="1" parent="1" source="maq_sms" target="area_desp" />
