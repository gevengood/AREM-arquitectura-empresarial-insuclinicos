        <mxCell id="g4" value="&lt;i&gt;«Goal»&lt;/i&gt;&lt;br&gt;&lt;b&gt;G-SEG · Continuidad operativa&lt;br&gt;y cumplimiento normativo&lt;/b&gt;&lt;br&gt;Cero SPOF (3-2-1), RBAC nominal&lt;br&gt;y blindaje Ley 1581 / ISO 27001" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#CCCCFF;strokeColor=#6666CC;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
