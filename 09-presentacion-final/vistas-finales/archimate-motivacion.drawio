        <mxCell id="p1" value="&lt;i&gt;«Principle»&lt;/i&gt;&lt;br&gt;&lt;b&gt;P1 · Sobriedad y Reúso&lt;/b&gt;&lt;br&gt;Adoptar SaaS/PaaS &amp;lt;= $3M/año;&lt;br&gt;&lt;b&gt;descarta desarrollo propio &amp;gt;$15M&lt;/b&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#CCCCFF;strokeColor=#4B4B9E;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=principle;archiType=oct;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
