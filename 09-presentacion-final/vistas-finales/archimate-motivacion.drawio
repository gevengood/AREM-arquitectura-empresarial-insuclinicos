        <mxCell id="req2" value="&lt;i&gt;«Requirement»&lt;/i&gt;&lt;br&gt;&lt;b&gt;REQ-02 · Maestros y Esquema DIAN&lt;/b&gt;&lt;br&gt;Cloud PostgreSQL aprovisionado,&lt;br&gt;catálogo ~40 clínicas y saldos SMS&lt;br&gt;&lt;i&gt;(Prepara GAP-01, GAP-02 · R8)&lt;/i&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#D8D8FF;strokeColor=#5A5A9E;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=requirement;archiType=oct;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
