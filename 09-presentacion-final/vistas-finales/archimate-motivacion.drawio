        <mxCell id="wp1" value="&lt;i&gt;«Work Package»&lt;/i&gt;&lt;br&gt;&lt;b&gt;WP1 · Quick win (Semanas 1–2)&lt;/b&gt;&lt;br&gt;Backup 3-2-1, 6 cuentas Windows,&lt;br&gt;bloqueo USB/SMB y Ley 1581&lt;br&gt;&lt;i&gt;Cierra: R3, R5, R6 · Esfuerzo: Bajo&lt;/i&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#FFCC99;strokeColor=#CC6600;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=workPackage;archiType=rounded;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
