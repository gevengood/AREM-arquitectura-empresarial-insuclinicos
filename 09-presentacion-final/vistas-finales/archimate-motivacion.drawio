        <mxCell id="p2" value="&lt;i&gt;«Principle»&lt;/i&gt;&lt;br&gt;&lt;b&gt;P2 · Fuente Única y Trazabilidad&lt;/b&gt;&lt;br&gt;BD única PostgreSQL; &lt;b&gt;prohíbe Excel&lt;br&gt;paralelo&lt;/b&gt; y exige lote SMS INVIMA" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#CCCCFF;strokeColor=#4B4B9E;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=principle;archiType=oct;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
