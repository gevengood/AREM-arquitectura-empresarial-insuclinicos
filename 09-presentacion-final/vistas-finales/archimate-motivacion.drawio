  <diagram id="archimate_view" name="ArchiMate Motivacion - Insuclinicos">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="910" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="banner1" value="&lt;b&gt;ArchiMate 3.2 — Vista de Motivación (Estrategia → Principios → Requerimientos → Paquetes de Trabajo)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;font-weight:normal'&gt;Cliente Real: Insuclínicos Ltda. · Trazabilidad completa desde Objetivos del Taller 0 hasta el Plan de Implementación del Taller 9&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14263C;strokeColor=#14263C;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="28" y="14" width="1484" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="stk" value="&lt;i&gt;«Stakeholder»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Insuclínicos Ltda.&lt;/b&gt;&lt;br&gt;Santiago Martínez (Gerencia)&lt;br&gt;6 trabajadores · ~40 clínicas" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#E8E8FF;strokeColor=#5A5A9E;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=stakeholder;archiType=oct;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="28" y="122" width="200" height="98" as="geometry"/>
        </mxCell>
        <mxCell id="drv1" value="&lt;i&gt;«Driver»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Operación fragmentada y papel&lt;/b&gt;&lt;br&gt;2 Excel aislados en LAN,&lt;br&gt;2–3 bloqueos/día y papel a planta&lt;br&gt;&lt;i&gt;(Problemas #1, #2 · T0/T3/T4)&lt;/i&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#CCCCFF;strokeColor=#6666CC;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=driver;archiType=oct;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="28" y="245" width="200" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="drv2" value="&lt;i&gt;«Driver»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Descuadres y SPOF local&lt;/b&gt;&lt;br&gt;Disco duro único sin backups (T5),&lt;br&gt;~6 h/sem perdidas y sin auditoría&lt;br&gt;&lt;i&gt;(Problema #3 · T4/T5)&lt;/i&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#CCCCFF;strokeColor=#6666CC;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=driver;archiType=oct;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="28" y="410" width="200" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="drv3" value="&lt;i&gt;«Driver»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Riesgo legal y sanitario&lt;/b&gt;&lt;br&gt;Sin trazabilidad INVIMA Dec. 4725&lt;br&gt;y WhatsApp sin Ley 1581&lt;br&gt;&lt;i&gt;(Solo 2/15 cumple · Taller 6)&lt;/i&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#CCCCFF;strokeColor=#6666CC;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=driver;archiType=oct;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="28" y="580" width="200" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="g1" value="&lt;i&gt;«Goal»&lt;/i&gt;&lt;br&gt;&lt;b&gt;OE-01 · Aumentar capacidad y&lt;br&gt;eficiencia de producción&lt;/b&gt;&lt;br&gt;Menos tiempos improductivos y&lt;br&gt;órdenes digitales en planta" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#CCCCFF;strokeColor=#6666CC;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="272" y="145" width="226" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="&lt;i&gt;«Goal»&lt;/i&gt;&lt;br&gt;&lt;b&gt;OE-02 · Mejorar control de&lt;br&gt;inventarios y materia SMS&lt;/b&gt;&lt;br&gt;Stock real sin descuadres ni&lt;br&gt;bloqueos de archivo" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#CCCCFF;strokeColor=#6666CC;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
