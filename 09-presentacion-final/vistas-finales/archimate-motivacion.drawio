        <mxCell id="req1" value="&lt;i&gt;«Requirement»&lt;/i&gt;&lt;br&gt;&lt;b&gt;REQ-01 · Higiene Base y Ley 1581&lt;/b&gt;&lt;br&gt;Backup 3-2-1 diario, 6 cuentas nominales,&lt;br&gt;cierre SMB/USB y WhatsApp Ley 1581&lt;br&gt;&lt;i&gt;(GAP-03, GAP-06, GAP-08, GAP-10)&lt;/i&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#D8D8FF;strokeColor=#5A5A9E;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=requirement;archiType=oct;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
