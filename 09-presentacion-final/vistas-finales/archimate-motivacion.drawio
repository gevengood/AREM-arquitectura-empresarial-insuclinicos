        <mxCell id="g3" value="&lt;i&gt;«Goal»&lt;/i&gt;&lt;br&gt;&lt;b&gt;OE-03 · Digitalizar información&lt;br&gt;y trazabilidad sanitaria&lt;/b&gt;&lt;br&gt;Pedido visible de punta a punta,&lt;br&gt;carga DIAN y lote INVIMA" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#CCCCFF;strokeColor=#6666CC;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=goal;archiType=oct;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
