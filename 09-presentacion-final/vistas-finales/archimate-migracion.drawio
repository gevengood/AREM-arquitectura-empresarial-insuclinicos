        </mxCell>
        <mxCell id="m_wp3" value="&lt;i&gt;«Work Package»&lt;/i&gt;&lt;br&gt;&lt;b&gt;WP3 · Largo plazo (Sem 9–12)&lt;/b&gt;&lt;br&gt;Wi-Fi WPA3 planta, Tablet Web y módulo&lt;br&gt;obligatorio de lotes INVIMA + PDF&lt;br&gt;&lt;i&gt;Riesgos: R4, R7 · Esfuerzo: Medio&lt;/i&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#FFCC99;strokeColor=#CC6600;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=workPackage;archiType=rounded;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1160" y="493" width="332" height="124" as="geometry"/>
        </mxCell>
        <mxCell id="gov_box" value="&lt;i&gt;«Principle» · Gobernanza y Decisiones (Sección 6)&lt;/i&gt;&lt;br&gt;&lt;b&gt;P1 Sobriedad (&amp;lt;=$3M/año) · P2 Fuente Única INVIMA · P3 Seguridad Pragmática&lt;/b&gt;&lt;br&gt;Comité ligero quincenal (criterio conformidad TO-BE) · ADR #1 (Cloud ERP) &amp;amp; ADR #2 (Tablet/CSV) · Riesgos R9 y R10 aceptado" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#CCCCFF;strokeColor=#6666CC;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=principle;archiType=oct;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="82" y="690" width="680" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="cap_box" value="&lt;i&gt;«Capability» · Capacidades Mejoradas al alcanzar Plateau TO-BE (Taller 7)&lt;/i&gt;&lt;br&gt;&lt;b&gt;CAP-01 Pedidos (2→4) · CAP-02 Inventario SMS (1→4) · CAP-03 Producción (2→4)&lt;/b&gt;&lt;br&gt;&lt;b&gt;CAP-04 Trazabilidad INVIMA (1→4) · CAP-05 Facturación DIAN (3→4) · CAP-06 Continuidad (1→4)&lt;/b&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#F5DEB3;strokeColor=#B7791F;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=capability;archiType=rounded;fontSize=11;verticalAlign=middle;align=center;spacing=6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="794" y="690" width="698" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="leg2" value="&lt;b&gt;Leyenda ArchiMate 3.2 (Sección 7.1 Implementación y Migración)&lt;/b&gt;&lt;br&gt;• Elementos: &lt;b&gt;Plateau&lt;/b&gt; = estado estable de transición · &lt;b&gt;Gap&lt;/b&gt; (verde punteado) = brecha del Taller 7 que separa Plateaus · &lt;b&gt;Work Package&lt;/b&gt; (durazno) = cada fila del plan de implementación · &lt;b&gt;Principle&lt;/b&gt; (lila) y &lt;b&gt;Capability&lt;/b&gt; (dorado).&lt;br&gt;• Relaciones exactas: &lt;b&gt;Asociación sólida sin flecha (—)&lt;/b&gt; vincula cada Gap con sus Plateaus y con el Work Package que lo cierra · &lt;b&gt;Realización (- - ▷)&lt;/b&gt; conecta cada Work Package con el Plateau que produce · &lt;b&gt;Triggering (→)&lt;/b&gt; secuencia fases · &lt;b&gt;Influencia (- - &amp;gt;)&lt;/b&gt; desde Gobernanza orienta los Work Packages." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="28" y="810" width="1484" height="112" as="geometry"/>
        </mxCell>
