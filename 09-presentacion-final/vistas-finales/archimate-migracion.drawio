        <mxCell id="banner2" value="&lt;b&gt;ArchiMate 3.2 — Vista de Implementación y Migración (Plateaus · Gaps · Work Packages)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;font-weight:normal'&gt;Insuclínicos Ltda. · Transición en 4 fases (12 semanas) conectando los 10 GAPs del Taller 7 al Plateau TO-BE bajo Gobierno ligero&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14263C;strokeColor=#14263C;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="28" y="14" width="1484" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="p_asis" value="&lt;i&gt;«Plateau»&lt;/i&gt;&lt;br&gt;&lt;b&gt;AS-IS Actual (Diagnóstico 2026)&lt;/b&gt;&lt;br&gt;2 Excel locales en disco único (SPOF) · sesiones compartidas,&lt;br&gt;SMB abiertas · órdenes en papel a planta · sin lote INVIMA,&lt;br&gt;doble digitación DIAN y WhatsApp sin Ley 1581" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#FFE4E6;strokeColor=#BE123C;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=plateau;archiType=square;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="82" y="96" width="410" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="p_trans" value="&lt;i&gt;«Plateau»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Plateau Intermedio (Semanas 1–4)&lt;/b&gt;&lt;br&gt;Operación protegida contra pérdida (Backup 3-2-1, 6 cuentas&lt;br&gt;nominales, USB/SMB bloqueados, aviso Ley 1581) + instancia&lt;br&gt;Cloud PostgreSQL lista con ~40 clínicas y SMS saneados" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#FFEDD5;strokeColor=#CC6600;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=plateau;archiType=square;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="555" y="96" width="425" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="p_tobe" value="&lt;i&gt;«Plateau»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Plateau TO-BE Consolidado (Semana 12)&lt;/b&gt;&lt;br&gt;CRM/ERP Cloud PostgreSQL (~$2.2M/año) + RBAC &amp;amp; audit_log +&lt;br&gt;Exportador CSV DIAN + Tablet Planta WPA3 con lote_sms_invima&lt;br&gt;obligatorio y Remisión Digital PDF sin papel" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#D1FAE5;strokeColor=#1C7150;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=plateau;archiType=square;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1050" y="96" width="425" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="gap1" value="&lt;i&gt;«Gap»&lt;/i&gt;&lt;br&gt;&lt;b&gt;GAP-03, GAP-06, GAP-08, GAP-10&lt;/b&gt;&lt;br&gt;SPOF disco local (T5), sesiones compartidas (T1/T6),&lt;br&gt;fuga por USB (T4) y canal WhatsApp sin Ley 1581" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=gap;archiType=rounded;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="185" y="310" width="355" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="gap2" value="&lt;i&gt;«Gap»&lt;/i&gt;&lt;br&gt;&lt;b&gt;GAP-01, GAP-02, GAP-04, GAP-07&lt;/b&gt;&lt;br&gt;Silos entre 2 Excel, bloqueos diarios LAN, maestros sucios,&lt;br&gt;sin bitácora (T2/T3) y doble digitación hacia DIAN" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=gap;archiType=rounded;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="620" y="310" width="385" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="gap3" value="&lt;i&gt;«Gap»&lt;/i&gt;&lt;br&gt;&lt;b&gt;GAP-05, GAP-09 (Planta e INVIMA)&lt;/b&gt;&lt;br&gt;Órdenes físicas impresas en papel hasta confección y&lt;br&gt;ausencia de vínculo lote rollo SMS → remisión clínica" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=gap;archiType=rounded;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1085" y="310" width="345" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="m_wp1" value="&lt;i&gt;«Work Package»&lt;/i&gt;&lt;br&gt;&lt;b&gt;WP1 · Quick win (Sem 1–2)&lt;/b&gt;&lt;br&gt;Backup 3-2-1, 6 cuentas nominales,&lt;br&gt;cierre SMB/USB y WhatsApp Ley 1581&lt;br&gt;&lt;i&gt;Riesgos: R3, R5, R6 · Esfuerzo: Bajo&lt;/i&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#FFCC99;strokeColor=#CC6600;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=workPackage;archiType=rounded;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="82" y="493" width="325" height="124" as="geometry"/>
        </mxCell>
        <mxCell id="m_wp2a" value="&lt;i&gt;«Work Package»&lt;/i&gt;&lt;br&gt;&lt;b&gt;WP2-A · Corto plazo (Sem 3–4)&lt;/b&gt;&lt;br&gt;Provisión Cloud PostgreSQL, depuración&lt;br&gt;maestros SMS/clínicas y esquema DIAN&lt;br&gt;&lt;i&gt;Riesgos: R8 (prepara R7) · Esfuerzo: Bajo&lt;/i&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#FFCC99;strokeColor=#CC6600;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=workPackage;archiType=rounded;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="438" y="493" width="325" height="124" as="geometry"/>
        </mxCell>
        <mxCell id="m_wp2b" value="&lt;i&gt;«Work Package»&lt;/i&gt;&lt;br&gt;&lt;b&gt;WP2-B · Mediano plazo (Sem 5–8)&lt;/b&gt;&lt;br&gt;Despliegue CRM/ERP, Kardex, RBAC,&lt;br&gt;audit_log, exportador DIAN y marcha blanca&lt;br&gt;&lt;i&gt;Riesgos: R1, R2, R7 · Esfuerzo: Medio&lt;/i&gt;" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#FFCC99;strokeColor=#CC6600;fontColor=#14263C;shape=mxgraph.archimate3.application;appType=workPackage;archiType=rounded;fontSize=11;verticalAlign=middle;align=center;spacing=6;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
